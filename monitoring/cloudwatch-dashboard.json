        "stat": "Average",
        "period": 60,
        "metrics": [
          [
            "AWS/AutoScaling",
            "GroupInServiceInstances",
            "AutoScalingGroupName",
            "dev-backend-asg",
            { "label": "In Service" }
          ],
          [
            "AWS/AutoScaling",
            "GroupDesiredCapacity",
            "AutoScalingGroupName",
            "dev-backend-asg",
            { "label": "Desired" }
          ]
        ]
      }
    }
  ]
