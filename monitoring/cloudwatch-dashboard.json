      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 19,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Redis — Current Connections",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "stat": "Average",
        "period": 60,
        "metrics": [
          [
            "AWS/ElastiCache",
            "CurrConnections",
            "ReplicationGroupId",
            "dev-redis",
