    {
      "type": "log",
      "x": 0,
      "y": 25,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "Backend — Recent Error Logs",
        "region": "us-east-1",
        "query": "SOURCE '/starttech/backend' | fields @timestamp, @message | filter @message like /ERROR/ | sort @timestamp desc | limit 50",
        "view": "table"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 31,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "ASG — Instance Count",
