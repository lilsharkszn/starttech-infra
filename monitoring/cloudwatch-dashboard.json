          "left": { "min": 0, "max": 100 }
        }
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 19,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Redis — Cache Hit Rate",
        "view": "timeSeries",
        "stacked": false,
        "region": "us-east-1",
        "stat": "Average",
        "period": 60,
        "metrics": [
          [
            "AWS/ElastiCache",
            "CacheHits",
            "ReplicationGroupId",
            "dev-redis",
            { "label": "Cache Hits", "color": "#77dd77" }
